  "start.title": {
    "en": "Insert an audio CD",
    "zh-CN": "请放入音乐 CD"
  },
  "start.subtitle": {
    "en": "CDR reads it, checks every track against AccurateRip and files it into your library.",
    "zh-CN": "CDR 会读取光盘，逐轨对照 AccurateRip 校验，然后存入你的曲库。"
  },
  "start.access_denied": {
    "en": "CDR isn't allowed to read discs. Allow it in System Settings › Privacy & Security › Files & Folders › CDR › Removable Volumes.",
    "zh-CN": "CDR 没有读取光盘的权限。请在「系统设置 › 隐私与安全性 › 文件与文件夹 › CDR › 可移除宗卷」中允许。"
  },
  "notice.auto_open_music": {
    "en": "macOS opens the Music app when you insert a CD, and it reads the disc at the same time as CDR. In System Settings › CDs & DVDs, set “When you insert a music CD” to Ignore.",
    "zh-CN": "插入 CD 时 macOS 会打开「音乐」App，它会和 CDR 同时读盘。请在「系统设置 › CD 与 DVD」中把「插入音乐 CD 时」设为「忽略」。"
  },
  "notice.auto_open_other": {
    "en": "macOS opens another app when you insert a CD, and it reads the disc at the same time as CDR. In System Settings › CDs & DVDs, set “When you insert a music CD” to Ignore.",
    "zh-CN": "插入 CD 时 macOS 会打开另一个 App，它会和 CDR 同时读盘。请在「系统设置 › CD 与 DVD」中把「插入音乐 CD 时」设为「忽略」。"
  },
